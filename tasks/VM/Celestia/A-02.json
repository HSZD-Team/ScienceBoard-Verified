{
    "type": "Celestia",
    "sort": "VM",
    "steps": 5,
    "instruction": "Set the time scale to 0.05x in Celestia, i.e. 20 times slower than real time.",
    "version": "0.1",
    "snapshot": "sci_bench",
    "initialize": [
        {
            "func": "opt",
            "depth": 6
        },
        {
            "func": "launch",
            "wait": 10,
            "command": "LD_LIBRARY_PATH=/home/user/6.5.0/gcc_64/lib /app/bin/celestia-qt6 «PORTLIKE»",
            "shell": true
        }
    ],
    "evaluate": [
        {
            "type": "info",
            "key": "lambda dump: dump['time']['scale']",
            "value": 0.05,
            "pred": "lambda key, value: abs(key - value) < 0.001"
        }
    ]
}
